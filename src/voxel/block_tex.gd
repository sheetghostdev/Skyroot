class_name BlockTex
extends RefCounted
## Block texture tiles: the atlas generated by tools/art/gen_blocks.py, split into
## a Texture2DArray (one layer per tile, with mipmaps) so faces can tile without
## bleeding.  Tile names map to layer indices through assets/textures/blocks.json.

const META := "res://assets/textures/blocks.json"
const ATLAS := "res://assets/textures/blocks.png"

static var _names: Dictionary = {}      # tile name -> layer
static var _avg: Dictionary = {}        # layer -> Color
static var _tile := 32
static var _cols := 16
static var _array: Texture2DArray = null
static var _images: Array[Image] = []


static func load_meta() -> void:
	if not _names.is_empty():
		return
	var f := FileAccess.open(META, FileAccess.READ)
	var m = JSON.parse_string(f.get_as_text()) if f else null
	if not m is Dictionary:
		push_error("BlockTex: missing " + META)
		return
	_tile = int(m.get("tile", 32))
	_cols = int(m.get("cols", 16))
	var i := 0
	for n in m["names"]:
		_names[String(n)] = i
		var c: Array = m["avg"].get(n, [0.5, 0.5, 0.5])
		_avg[i] = Color(c[0], c[1], c[2])
		i += 1


static func layer(tile_name: String) -> int:
	if tile_name == "":
		return 0
	if not _names.has(tile_name):
		push_warning("BlockTex: unknown tile '%s'" % tile_name)
		return 0
	return int(_names[tile_name])


static func avg_color(l: int) -> Color:
	return _avg.get(l, Color(0.5, 0.5, 0.5))


static func tile_image(l: int) -> Image:
	_ensure_images()
	return _images[l] if l >= 0 and l < _images.size() else null


static func _ensure_images() -> void:
	if not _images.is_empty():
		return
	load_meta()
	var tex: Texture2D = load(ATLAS)
	if tex == null:
		push_error("BlockTex: missing " + ATLAS)
		return
	var atlas := tex.get_image()
	if atlas.is_compressed():
		atlas.decompress()
	atlas.convert(Image.FORMAT_RGBA8)
	for i in _names.size():
		var x := (i % _cols) * _tile
		var y := (i / _cols) * _tile
		var img := atlas.get_region(Rect2i(x, y, _tile, _tile))
		_images.append(img)


static func array() -> Texture2DArray:
	if _array:
		return _array
	_ensure_images()
	var mipped: Array[Image] = []
	for img in _images:
		var m := img.duplicate() as Image
		m.generate_mipmaps()
		mipped.append(m)
	_array = Texture2DArray.new()
	_array.create_from_images(mipped)
	return _array


static func clear() -> void:
	_array = null
	_images.clear()
